<section id="newsletter">
  <div id="newsletter-content">
    <section>
      <h1 class="section-title">Subscribe newsletter</h1>
      <!-- <img src="/deploy/img/global/Ellipse 11.svg" alt="" /> -->
      <p class="body-grey-text">
        Businesses generally promote their brand, products, and services by
        identifying audience. No wonder that promotion strategy is one of the
        most important processes in marketing!
      </p>

      <form action="#">
        <input type="text" placeholder="Enter email address" name="" id="" />
        <div><button class="nightblue-btn">Subscribe</button></div>
      </form>
    </section>
    <aside>
      <img
        src="/deploy/img/newsletter/hero.png"
        alt="happy person"
        class="img-scaler"
      />
    </aside>
  </div>
</section>
