<section id="hero">
  <section>
    <!-- content will go here -->
    <article>
      <h1 class="section-title">
        Perfect place for your business promotion ✌️
      </h1>
      <p class="body-grey-text">
        Businesses generally promote their brand, products, and services by
        identifying audience.
      </p>
      <a href="#" class="nightblue-link">Get Started</a>
      <button>
        <img src="/deploy/img/hero/play btn.svg" alt="play button" />
      </button>
    </article>

    <article id="hero-card">
      <img src="/deploy/img/hero/quote.svg" alt="quote" />
      <img src="/deploy/img/hero/star.svg" alt="star" />
      <h5>4.9</h5>
      <p class="body-grey-text">
        There’s no shortage of ideas, what’s missing is the will to execute them
        – Seth Godin
      </p>
    </article>
  </section>

  <aside>
    <!-- tag for image -->
    <img
      src="/deploy/img/hero/hero-right.png"
      alt="image of happy person"
      class="img-scaler"
    />
  </aside>
</section>
