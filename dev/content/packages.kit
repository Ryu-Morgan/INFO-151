<section id="packages">
  <h1>Popular packages</h1>
  <img src="/deploy/img/global/Ellipse 11.svg" alt="" />
  <div id="package-btn-container">
    <button id="left-arrow">
      <img src="/deploy/img/packages/arrow-left.svg" alt="left button" />
    </button>
    <button id="right-arrow">
      <img
        src="/deploy/img/packages/chevron-right-solid.svg"
        alt="right button"
      />
    </button>
  </div>
  <ul id="package-card-container">
    <li class="package-card">
      <img
        src="/deploy/img/packages/card1.jpg"
        alt="hero image"
        class="img-scaler"
      />
      <p>The basic package to start your promotion</p>
      <ul>
        <li>
          <img src="/deploy/img/packages/user1.jpg" alt="user icon" />
        </li>
        <li>
          <img src="/deploy/img/packages/user2.jpg" alt="user icon" />
        </li>
        <li>
          <img src="/deploy/img/packages/user3.jpg" alt="user icon" />
        </li>
      </ul>
      <h4>200K+ users</h4>
      <h3>$89.00</h3>
    </li>

    <li class="selected package-card">
      <img
        src="/deploy/img/packages/card2.jpg"
        alt="hero image"
        class="img-scaler"
      />
      <p>The standard package to grow your business</p>
      <ul>
        <li>
          <img src="/deploy/img/packages/user4.jpg" alt="user icon" />
        </li>
        <li>
          <img src="/deploy/img/packages/user2.jpg" alt="user icon" />
        </li>
        <li>
          <img src="/deploy/img/packages/user5.jpg" alt="user icon" />
        </li>
      </ul>
      <h4>140+ users</h4>
      <h3>$109.00</h3>
    </li>

    <li class="package-card">
      <img
        src="/deploy/img/packages/card3.jpg"
        alt="hero image"
        class="img-scaler"
      />
      <p>The premium package to boost your promotion</p>
      <ul>
        <li>
          <img src="/deploy/img/packages/user4.jpg" alt="user icon" />
        </li>
        <li>
          <img src="/deploy/img/packages/user2.jpg" alt="user icon" />
        </li>
        <li>
          <img src="/deploy/img/packages/user5.jpg" alt="user icon" />
        </li>
      </ul>
      <h4>99+ users</h4>
      <h3>$149.00</h3>
    </li>
  </ul>
</section>
